# Inkloom AI - Backend Environment Configuration Example
# Copy to .env for local development

# Environment Mode
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Application Metadata
APP_NAME="Inkloom AI Brand Governance API"
API_V1_PREFIX=/api/v1

# Security & CORS
# In production, replace with actual origin domains (e.g. https://app.inkloom.ai)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default uses local SQLite for zero-config startup; set to PostgreSQL for multi-tenant prod
DATABASE_URL=sqlite:///./inkloom_dev.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/inkloom_ai

# File Storage & Upload Limits
UPLOAD_STORAGE_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_MEDIA_TYPES=["text/plain","application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document","image/png","image/jpeg","image/webp","video/mp4"]

# AI Audit Engine & Assistant LLM Configuration
# Deterministic rule engine is default (requires NO paid API key)
AI_ENGINE_MODE=deterministic

# To enable real Gemini generation for the assistant, set:
# LLM_PROVIDER=gemini
# LLM_API_KEY=your_google_ai_studio_api_key_here
# Note: LLM_MODEL_NAME must be a current Gemini model name copied from Google AI Studio (e.g., gemini-1.5-flash or gemini-1.5-pro)
LLM_PROVIDER=offline_rule_engine
LLM_API_KEY=
LLM_MODEL_NAME=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=800
CHAT_RATE_LIMIT_PER_MINUTE=10
