# Inkloom AI - Backend Environment Configuration Example
# Copy to .env for local development

# Environment Mode
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Application Metadata
APP_NAME="Inkloom AI Brand Governance API"
API_V1_PREFIX=/api/v1

# Security & CORS
# In production, replace with actual origin domains (e.g. https://app.inkloom.ai)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default uses local SQLite for zero-config startup; set to PostgreSQL for multi-tenant prod
DATABASE_URL=sqlite:///./inkloom_dev.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/inkloom_ai

# File Storage & Upload Limits
UPLOAD_STORAGE_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_MEDIA_TYPES=["text/plain","application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document","image/png","image/jpeg","image/webp","video/mp4"]

# Real-Time Gemini AI Assistant & Brand Governance Engine
AI_ENGINE_MODE=online

# Unified AI Layer (app/ai/) Configuration
# Provider choices: gemini | offline
LLM_PROVIDER=gemini
_KEY="AQ.Ab8RN6KruE828jo2vpDRGZfu3eB246FGcrNpywoUFFXXaVxqAw"
LLM_MODEL_NAME=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1500
CHAT_RATE_LIMIT_PER_MINUTE=60
