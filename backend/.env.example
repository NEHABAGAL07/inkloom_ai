# Inkloom AI - Backend Environment Configuration Template
ENVIRONMENT=development
PROJECT_NAME="Inkloom AI"
API_V1_STR="/api/v1"
DEBUG=true

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Security (Placeholder - never commit real secret in production)
SECRET_KEY=inkloom-development-insecure-secret-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database
# For quick local testing without PostgreSQL, use SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./inkloom_dev.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inkloom_ai

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# File Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB

# AI Audit Engine
LLM_PROVIDER=rule_based_fallback # Options: rule_based_fallback, gemini, openai, mock
LLM_API_KEY=
LLM_MODEL_NAME=gemini-1.5-pro
LLM_TIMEOUT_SECONDS=8.0
CLAIM_VERIFICATION_THRESHOLD=0.75
MAX_AUDIT_TEXT_LENGTH=500000

# Media QA Tools
ENABLE_OCR=true
TESSERACT_CMD=tesseract
FFMPEG_CMD=ffmpeg
