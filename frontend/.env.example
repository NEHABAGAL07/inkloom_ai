# Inkloom AI - Frontend Environment Configuration Example
# Copy to .env.local for local frontend development

# API Backend Target URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Mock Mode Toggle
# Set to 'true' to develop entirely with deterministic mock data
# Set to 'false' to communicate with running FastAPI backend
NEXT_PUBLIC_USE_MOCK=true

# Organization / Tenant Context Default
NEXT_PUBLIC_DEFAULT_TENANT_ID=org_default_inkloom
