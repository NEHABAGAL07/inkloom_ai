# Inkloom AI Frontend Environment Variables
# In live mode, requests connect directly to the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000/api

# Enable mock mode to run entirely on client-side synthetic data (true/false)
VITE_USE_MOCK_API=false

# App Title & Branding
VITE_APP_TITLE=Inkloom AI
