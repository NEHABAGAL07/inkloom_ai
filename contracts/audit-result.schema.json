{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkloom.ai/schemas/audit-result.v1.json",
  "title": "InkloomAuditResult",
  "description": "Standardized schema for Inkloom AI brand governance audit results across Backend, Frontend, AI Engine, and Media Processor.",
  "type": "object",
  "required": [
    "schema_version",
    "audit_id",
    "content_id",
    "overall_status",
    "summary",
    "findings",
    "created_at",
    "engine_metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the audit contract, e.g., 1.0.0"
    },
    "audit_id": {
      "type": "string",
      "description": "Unique identifier for this audit execution."
    },
    "content_id": {
      "type": "string",
      "description": "Unique identifier for the audited content piece or submission."
    },
    "revision_id": {
      "type": ["string", "null"],
      "description": "Optional specific revision ID of the content audited."
    },
    "overall_status": {
      "type": "string",
      "enum": ["compliant", "needs_review", "non_compliant", "error"],
      "description": "High-level governance compliance status."
    },
    "summary": {
      "type": "object",
      "required": [
        "compliance_score",
        "total_findings",
        "critical_count",
        "high_count",
        "medium_count",
        "low_count",
        "info_count",
        "human_review_required"
      ],
      "properties": {
        "compliance_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Calculated score between 0 and 100 where 100 is fully compliant."
        },
        "total_findings": {
          "type": "integer",
          "minimum": 0
        },
        "critical_count": {
          "type": "integer",
          "minimum": 0
        },
        "high_count": {
          "type": "integer",
          "minimum": 0
        },
        "medium_count": {
          "type": "integer",
          "minimum": 0
        },
        "low_count": {
          "type": "integer",
          "minimum": 0
        },
        "info_count": {
          "type": "integer",
          "minimum": 0
        },
        "human_review_required": {
          "type": "boolean",
          "description": "True if any finding or regulatory rule mandates human approval before publishing."
        },
        "verdict_overview": {
          "type": "string",
          "description": "Human-readable synthesis of key audit conclusions."
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Finding"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when audit finished."
    },
    "engine_metadata": {
      "type": "object",
      "required": ["engine_version", "execution_time_ms", "modules_executed"],
      "properties": {
        "engine_version": {
          "type": "string"
        },
        "execution_time_ms": {
          "type": "number",
          "minimum": 0
        },
        "modules_executed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "models_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Finding": {
      "type": "object",
      "required": [
        "id",
        "category",
        "severity",
        "title",
        "message",
        "confidence",
        "status",
        "requires_human_review"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the finding."
        },
        "category": {
          "type": "string",
          "enum": [
            "tone_voice",
            "terminology",
            "claim_verification",
            "visual_brand",
            "accessibility",
            "editorial_standards",
            "legal_compliance"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low", "info"]
        },
        "title": {
          "type": "string",
          "description": "Short headline of the finding."
        },
        "message": {
          "type": "string",
          "description": "Detailed explanation of the governance issue and why it violates guideline."
        },
        "evidence": {
          "type": ["string", "null"],
          "description": "Direct excerpt or quote from the submitted content illustrating the issue. Null if unavailable."
        },
        "source_reference": {
          "type": ["object", "null"],
          "description": "Approved guideline reference or fact verification source. Never fabricated; null if missing.",
          "properties": {
            "guideline_id": { "type": "string" },
            "section": { "type": "string" },
            "rule_name": { "type": "string" },
            "source_url": { "type": ["string", "null"] },
            "is_external": { "type": "boolean" },
            "verification_status": {
              "type": "string",
              "enum": ["verified", "unverified", "contradicted", "not_applicable"]
            }
          },
          "required": ["rule_name", "verification_status"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "AI engine confidence score in this assessment (0.0 to 1.0), independent of severity."
        },
        "suggested_correction": {
          "type": ["object", "null"],
          "properties": {
            "replacement_text": { "type": "string" },
            "rationale": { "type": "string" },
            "preserves_intent": { "type": "boolean" }
          },
          "required": ["replacement_text", "rationale"]
        },
        "status": {
          "type": "string",
          "enum": ["open", "accepted", "dismissed", "manual_check_required"]
        },
        "location": {
          "type": ["object", "null"],
          "properties": {
            "page_number": { "type": "integer", "minimum": 1 },
            "line_number": { "type": "integer", "minimum": 1 },
            "start_char": { "type": "integer", "minimum": 0 },
            "end_char": { "type": "integer", "minimum": 0 },
            "timestamp_seconds": { "type": "number", "minimum": 0.0 },
            "bounding_box": {
              "type": "object",
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" },
                "width": { "type": "number" },
                "height": { "type": "number" }
              },
              "required": ["x", "y", "width", "height"]
            }
          }
        },
        "requires_human_review": {
          "type": "boolean",
          "description": "Flags if human reviewer confirmation is mandatory before accepting this finding."
        }
      },
      "additionalProperties": false
    }
  }
}
