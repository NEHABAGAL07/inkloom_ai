# Inkloom AI — Root Development Environment Template
# Copy to .env for Docker Compose local orchestration

# Global Application Settings
ENVIRONMENT=development
DEBUG=true

# Database Settings
POSTGRES_USER=inkloom_user
POSTGRES_PASSWORD=inkloom_secure_dev_password
POSTGRES_DB=inkloom_ai
DATABASE_URL=postgresql+psycopg2://inkloom_user:inkloom_secure_dev_password@db:5432/inkloom_ai

# Backend API Configuration
BACKEND_PORT=8000
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALLOWED_ORIGINS=http://localhost:3000

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCK=false

# Real-Time Gemini AI Configuration
AI_ENGINE_MODE=online
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL_NAME=gemini-3.5-flash-lite